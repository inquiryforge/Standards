{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard hierarchy record",
  "type": "object",
  "required": [
    "id",
    "parent_id",
    "node_type",
    "code",
    "title",
    "jurisdiction",
    "subject",
    "framework",
    "edition",
    "grade_band",
    "status",
    "source",
    "children",
    "path",
    "text",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "node_type": {
      "enum": [
        "group",
        "collection",
        "domain",
        "cluster",
        "strand",
        "topic",
        "standard",
        "substandard",
        "state-extension",
        "not-applicable"
      ]
    },
    "jurisdiction": {
      "const": "US-MI"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "framework": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "grade_band": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 12
      }
    },
    "status": {
      "type": "string"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ]
      }
    },
    "children": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "path": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
